      "--noEmit",
      "-p",
      "tests/ui-state/tsconfig.json"
    ],
    "exit_code": 0,
    "output": ""
  },
  {
    "name": "handler",
    "command": [
      "node",
      "karta/node_modules/typescript/bin/tsc",
      "--noEmit",
      "--strict",
      "--skipLibCheck",
      "--target",
      "es2022",

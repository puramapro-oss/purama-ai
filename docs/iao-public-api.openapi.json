        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "code": {
            "type": "string",
            "enum": [
              "IAO_API_INVALID",
              "IAO_API_UNAUTHORIZED",
              "IAO_API_FORBIDDEN",
              "IAO_API_NOT_FOUND",
              "IAO_API_METHOD",
              "IAO_API_TOO_LARGE",
              "IAO_API_MEDIA_TYPE",
              "IAO_API_RATE_LIMIT",
              "IAO_API_LIMIT",
              "IAO_API_INVALID_RESPONSE",
              "IAO_API_UNAVAILABLE",
              "IAO_API_TIMEOUT",
              "IAO_INVALID",
              "IAO_FORBIDDEN",
              "IAO_CONFLICT",
              "IAO_BUDGET",
              "IAO_UNAVAILABLE"
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "code",
          "error"
        ],
        "description": "Code public stable et message générique ; jamais de détail brut de fournisseur, clé, grant ou erreur SQL."
      }

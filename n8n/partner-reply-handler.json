{
  "name": "Partner Agent — Reply Handler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "cron",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "url": "https://auth.purama.dev/rest/v1/email_agent_config?is_active=eq.true&select=user_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Accept-Profile",
              "value": "purama_ai"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "users",
      "name": "Accounts with active Gmail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        320
      ],
      "retryOnFail": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Credentials stay in the server-side Email runtime; n8n receives account IDs only.\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst rows = $input.all().flatMap(item => Array.isArray(item.json) ? item.json : [item.json]);\nconst seen = new Set();\nreturn rows.filter(row => row && typeof row.user_id === 'string' && uuid.test(row.user_id)\n  && !seen.has(row.user_id) && seen.add(row.user_id))\n  .map(row => ({ json: { user_id: row.user_id } }));"
      },
      "id": "normalize",
      "name": "Valid accounts only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        320
      ]
    },
    {
      "parameters": {
        "url": "https://auth.purama.dev/functions/v1/partner-sync-replies",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Impersonate-User-Id",
              "value": "={{ $json.user_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"limit\":5}",
        "options": {
          "timeout": 65000
        }
      },
      "id": "sync",
      "name": "Verify and record replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        320
      ],
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst rows = $input.all().flatMap(item => Array.isArray(item.json) ? item.json : [item.json]);\nreturn rows.flatMap(row => {\n  if (!row || !uuid.test(row.user_id || '') || !Array.isArray(row.recorded)) return [];\n  return row.recorded.filter(receipt => receipt && uuid.test(receipt.prospect_id || '')\n    && ['human', 'refusal', 'automatic', 'delivery_failure'].includes(receipt.kind))\n    .map(receipt => ({ json: {\n      user_id: row.user_id, prospect_id: receipt.prospect_id, kind: receipt.kind\n    } }));\n});"
      },
      "id": "notifications",
      "name": "New durable receipts only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        320
      ]
    },
    {
      "parameters": {
        "url": "https://auth.purama.dev/functions/v1/agent-push-send",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.user_id, agent_type: 'partner', title: $json.kind === 'delivery_failure' ? 'Envoi partenaire à examiner' : 'Réponse partenaire vérifiée', body: $json.kind === 'refusal' ? 'Refus reçu : sollicitations arrêtées.' : $json.kind === 'automatic' ? 'Réponse automatique reçue : relances suspendues.' : $json.kind === 'delivery_failure' ? 'Rejet ou plainte confirmé : sollicitations arrêtées.' : 'Une réponse est disponible dans le dossier partenaire.', action_type: 'review', action_payload: { prospect_id: $json.prospect_id }, action_url: '/dashboard/partner-agent/prospects', priority: 'normal', channels: ['push', 'in_app'] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "notify",
      "name": "Notify account owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        320
      ],
      "retryOnFail": false,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Accounts with active Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Accounts with active Gmail": {
      "main": [
        [
          {
            "node": "Valid accounts only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid accounts only": {
      "main": [
        [
          {
            "node": "Verify and record replies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify and record replies": {
      "main": [
        [
          {
            "node": "New durable receipts only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "New durable receipts only": {
      "main": [
        [
          {
            "node": "Notify account owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  }
}

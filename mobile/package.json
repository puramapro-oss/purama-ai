{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "update": "eas update --branch production",
    "typecheck": "tsc --noEmit --incremental false",
    "test:dependencies": "node --test --test-concurrency=1 tests/dependency-compat.test.cjs",
    "test:local-communication": "node --test --test-concurrency=1 tests/local-communication.test.cjs",
    "check:dependencies": "expo install --check",
    "export:android": "expo export --platform android --output-dir dist/android --max-workers 2 --dump-assetmap",
    "export:ios": "expo export --platform ios --output-dir dist/ios --max-workers 2 --dump-assetmap",
    "test:audit-snapshot": "node --test tests/audit-snapshot.test.cjs",
    "verify:audit-snapshot": "node scripts/verify-audit-snapshot.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.103.0",
    "decode-uri-component": "file:compat/decode-uri-component",
    "expo": "~54.0.38",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "image-size": "file:compat/image-size",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "54.0.12",
    "react-test-renderer": "19.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    },
    "metro": {
      "image-size": "$image-size"
    },
    "@expo/metro-config": {
      "postcss": "8.5.32"
    }
  }
}

# Supabase Edge Functions · inventaire de déploiement
# Valeurs à configurer avec `supabase secrets set`; ne jamais committer de valeur réelle.

# Supabase (généralement injectées automatiquement par Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique canonique
APP_URL=https://purama-ai.purama.dev
CORS_ALLOWED_ORIGIN=https://purama-ai.purama.dev
OAUTH_ALLOWED_ORIGINS=https://purama-ai.purama.dev,https://purama.dev

# IA et recherche (selon les fonctions activées)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=
ANTHROPIC_MODEL_FAST=
LOVABLE_API_KEY=
TAVILY_API_KEY=

# Paiements et fiscalité
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
INSEE_API_KEY=

# Email, voix et notifications push
RESEND_API_KEY=
ELEVENLABS_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@purama-ai.purama.dev

# OAuth Gmail / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GMAIL_OAUTH_STATE_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=

# Bridge, DocuSeal et outils sociaux
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
DOCUSEAL_API_KEY=
DOCUSEAL_API_TOKEN=
DOCUSEAL_API_URL=https://docuseal.purama.dev
DOCUSEAL_URL=https://docuseal.purama.dev
DOCUSEAL_WEBHOOK_SECRET=
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Services internes, webhooks et tâches planifiées
CRON_SECRET=
WEBHOOK_SECRET=
KARTA_INTERNAL_URL=
KARTA_ADMIN_TOKEN=
PURAMA_SERVICE_SECRET_V1=
PURAMA_SERVICE_SECRET_V2=

# Callback social: désactivé tant que les deux valeurs ne sont pas configurées.
SOCIAL_CALLBACK_ENABLED=false
SOCIAL_CALLBACK_SHARED_SECRET=

# Marqueurs d'environnement optionnels
DENO_ENV=production
ENVIRONMENT=production

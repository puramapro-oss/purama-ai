{
  "name": "karta-engine",
  "version": "1.0.0",
  "description": "KARTA Engine — orchestrateur natif d'agents IA Purama (remplace n8n pour les agents cœur)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "reseed:agents": "tsx scripts/reseed-agents.ts",

    "ioredis": "^5.4.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }

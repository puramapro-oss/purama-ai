# KARTA Engine — variables d'environnement
# Copier en .env sur le VPS (jamais commit).

# Supabase (auth.purama.dev — schéma purama_ai)
SUPABASE_URL=https://auth.purama.dev
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Délai complet du modèle, en millisecondes (entier 1000..120000).
# Couvre aussi la lecture du corps ; aucune reprise automatique dans le SDK.
KARTA_MODEL_TIMEOUT_MS=60000
# Cache du préfixe public, opt-in : off (défaut) ou 5m.
# Uniquement Anthropic natif sans outils : rôle/contexte restent hors cache.
# Ignoré pour passerelles compatibles, LM Studio et requêtes avec outils.
# Les écritures coûtent davantage ; mesurer les reçus avant activation.
# Un préfixe sous le minimum du modèle ne produit pas de cache touché.
KARTA_ANTHROPIC_PROMPT_CACHE=off
# KARTA_MOCK_CLAUDE=true tant que le crédit Anthropic n'est pas rechargé.
# Règle permanente (2026-07-26) : ne JAMAIS bloquer le dev sur les crédits — mock actif par défaut,
# à repasser sur "false" juste avant le vrai lancement (cf task_plan.md "TODO_LIVE_TEST").
KARTA_MOCK_CLAUDE=true

# Redis (queue BullMQ) — network_mode: host côté docker-compose.yml, port 6380 dédié
# pour ne pas entrer en conflit avec un éventuel Redis existant sur 6379.
REDIS_URL=redis://127.0.0.1:6380

# Stripe
STRIPE_SECRET_KEY=
# UUID du propriétaire des factures Stripe de la plateforme. Vide = accès refusé.
# Ne jamais utiliser une valeur fournie par le navigateur ou par le modèle.
KARTA_PLATFORM_OWNER_USER_ID=

# Google OAuth (Gmail + Calendar, tokens par user dans email_agent_config)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@purama-ai.purama.dev

# Outils tiers
TAVILY_API_KEY=
ZERNIO_API_KEY=
# URL HTTPS explicite de l’adaptateur privé compatible avec POST /publish.
ZERNIO_BASE_URL=
DOCUSEAL_API_KEY=
DOCUSEAL_BASE_URL=http://docuseal:3000
APOLLO_API_KEY=

# API interne KARTA (health check + kill switch)
KARTA_PORT=4100
# Token bearer requis pour les endpoints mutants (kill switch, trigger manuel). À générer (openssl rand -hex 32).
KARTA_ADMIN_TOKEN=

# Rapport quotidien
DAILY_REPORT_CRON=0 8 * * *
DAILY_REPORT_EMAIL_FROM=hello@purama-ai.purama.dev

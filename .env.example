# ─── Purama AI · environnement local (copier vers .env — ne jamais committer) ───

# Supabase (self-hosted sur VPS Hostinger)
VITE_SUPABASE_URL="https://auth.purama.dev"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key Supabase (JWT — voir ~/purama/CLAUDE.md §17)>"
VITE_SUPABASE_PROJECT_ID="purama-ai"

# App
VITE_APP_URL="https://purama-ai.purama.dev"
VITE_APP_SLUG="purama-ai"
VITE_PALETTE_SEED="tech-cyber-purama-ai"

# Web Push (VAPID)
VITE_VAPID_PUBLIC_KEY="<VAPID public key>"

# ─── Côté serveur uniquement (NE JAMAIS exposer côté client) ─────────
# Placées dans les Vercel env vars ou Supabase Edge Function secrets.
# OPENAI_API_KEY=<sk-proj-…>
# ANTHROPIC_API_KEY=<sk-ant-…>
# STRIPE_SECRET_KEY=<sk_live_…>
# STRIPE_WEBHOOK_SECRET=<whsec_…>
# INSEE_API_KEY=<clé universelle Purama>
# CRON_SECRET=<secret partagé CRONs n8n>
